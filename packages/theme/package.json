{
  "name": "@gigradar/theme",
  "version": "2.0.0",
  "description": "GigRadar design tokens — colors, typography, spacing, radius, shadow. Extracted from Figma.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsc --build tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
